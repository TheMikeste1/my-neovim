{
  "Create a Lua class": {
    "prefix": ["clss"],
    "body": [
      "--- $3",
      "---@class $2.$1",
      "local $1 = {}",
      "$1.__index = $1",
      "",
      "---@class $2.$1",
      "local _$1Defaults = {",
      "  $0",
      "}",
      "",
      "---Creates a new $1 instance.",
      "---@param o? $2.$1 Optional initial values.",
      "---@return $2.$1 obj The new instance.",
      "function $1.new(o)",
      "  local self = setmetatable(o and vim.deepcopy(o) or {}, $1)",
      "  for k, v in pairs(_$1Defaults) do",
      "    if self[k] == nil then",
      "      if type(v) == \"table\" then",
      "        self[k] = vim.deepcopy(v)",
      "      else",
      "        self[k] = v",
      "      end",
      "    end",
      "  end",
      "  return self",
      "end"
    ]
  }
}
