{
  "Create a Lua class": {
    "prefix": ["clss"],
    "body": [
      "--- $3",
      "---@class $2.$1",
      "local $1 = {}",
      "$1.__index = $1",
      "",
      "--- Creates a new $1 instance.",
      "---@param o $2.$1 Initial values.",
      "---@return $2.$1 obj The new instance.",
      "function $1.new(o)",
      "  assert(o ~= nil, \"$1.new: `o` is required\")",
      "  local self = setmetatable(vim.deepcopy(o), $1)",
      "  return self",
      "end"
    ]
  },
  "Create a Lua class with defaults": {
    "prefix": ["clss_defaults"],
    "body": [
      "--- $3",
      "---@class $2.$1",
      "local $1 = {}",
      "$1.__index = $1",
      "",
      "---@class $2.$1",
      "local _$1Defaults = {",
      "  $0",
      "}",
      "",
      "--- Creates a new $1 instance.",
      "---@param o $2.$1 Initial values.",
      "---@return $2.$1 obj The new instance.",
      "function $1.new(o)",
      "  assert(o ~= nil, \"$1.new: `o` is required\")",
      "  local self = setmetatable(vim.deepcopy(o), $1)",
      "  for k, v in pairs(_$1Defaults) do",
      "    if self[k] == nil then",
      "      if type(v) == \"table\" then",
      "        self[k] = vim.deepcopy(v)",
      "      else",
      "        self[k] = v",
      "      end",
      "    end",
      "  end",
      "  return self",
      "end"
    ]
  },
  "Create a Lua class that inherits": {
    "prefix": ["clss_inherit"],
    "body": [
      "---@type $5",
      "local ${4:Super} = require(\"$3\")",
      "",
      "--- $6",
      "---@class $2.$1: $5",
      "local $1 = setmetatable({}, { __index = ${4:Super} })",
      "$1.__index = $1",
      "",
      "---@class $2.$1",
      "local _$1Defaults = {",
      "  $0",
      "}",
      "",
      "--- Creates a new $1 instance.",
      "---@param o $2.$1 Initial values.",
      "---@return $2.$1 obj The new instance.",
      "function $1.new(o)",
      "  assert(o ~= nil, \"$1.new: `o` is required\")",
      "  local self = ${4:Super}.new(o)",
      "  setmetatable(self, $1)",
      "  ---@cast self $2.$1",
      "  for k, v in pairs(_$1Defaults) do",
      "    if self[k] == nil then",
      "      self[k] = type(v) == \"table\" and vim.deepcopy(v) or v",
      "    end",
      "  end",
      "  return self",
      "end"
    ]
  }
}
